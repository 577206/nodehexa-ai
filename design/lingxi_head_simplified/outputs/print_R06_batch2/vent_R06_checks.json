  "assembly_order": [
    "移开H02下方深腔底座，从主体内放入M2螺母",
    "左右各先装灰色百叶，再套橙色外框",
    "每侧上孔M2x25、下孔M2x20盘头螺丝，轻轻拧紧",
    "确认透明盖和左侧USB线仍可拆装，再装回H02底座"
  ],
  "limitations": [
    "螺钉/螺母为标称M2尺寸；实物打印装配尚未验证",
    "完整移除通风组件时先拆外框、再取灰色百叶；灰色百叶不应强行穿过橙框",
    "0.2mm初始轴向间隙用于装配，紧固时需轻压贴合，不可过紧"
  ]
